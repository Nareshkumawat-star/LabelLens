# LabelLens — environment variables
#
# All of these are SERVER-side values. Never prefix them with NEXT_PUBLIC_,
# and never commit a real .env file.

# Google Gemini API key. Inference runs on the hosted Gemini API — not on
# your machine and not in the browser.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Multimodal model id used for image understanding.
# Confirm this id is available to your key/region before deploying; the app
# reports a real API error rather than silently substituting another model.
GEMMA_MODEL=gemini-2.0-flash

# MongoDB Atlas connection string (includes credentials).
# Create a cluster at https://cloud.mongodb.com, then copy the connection
# string for your database user.
MONGODB_URI=mongodb+srv://nareshkmt112006_db_user:o0BcTpzbDlWfruCq@cluster0.nqijpz1.mongodb.net/
