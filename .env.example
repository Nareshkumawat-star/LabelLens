# LabelLens — environment variables (template, DO NOT commit real values)
# Copy to .env.local for local dev. All values are SERVER-side.

# Google Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Multimodal model id for image understanding.
# Confirm the id is available to your key/region before deploying; the app
# validates it against the API and reports a real error if it is retired.
GEMMA_MODEL=gemini-3.8-flash

# MongoDB Atlas connection string (includes credentials)
MONGODB_URI=mongodb+srv://username:password@cluster0.nqijpz1.mongodb.net/labellens
