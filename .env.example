# LabelLens — environment variables example
#
# All of these are SERVER-side values. Never prefix them with NEXT_PUBLIC_,
# and never commit a real .env file. Copy this file to .env.local for local dev.

# Google Gemini API key. Inference runs on the hosted Gemini API.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Multimodal model id used for image understanding.
GEMMA_MODEL=gemini-2.0-flash

# MongoDB Atlas connection string. Replace with your own credentials:
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/labellens
